{
  "name": "@noteclaw/mcp-server",
  "version": "2.0.0",
  "type": "module",
  "description": "Durable MCP memory bank with live WebSocket events for third-party AI agents",
  "main": "dist/index.js",
  "bin": {
    "noteclaw-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "build:standalone": "node ./scripts/build-standalone.cjs",
    "check:contract": "node ./scripts/check-contract.mjs",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-memory",
    "websocket"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.3",
    "axios": "^1.13.4",
    "dotenv": "^17.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
