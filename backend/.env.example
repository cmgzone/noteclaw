# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Neon Database Configuration
NEON_HOST=your-neon-host.neon.tech
NEON_DATABASE=neondb
NEON_USERNAME=neondb_owner
NEON_PASSWORD=your-password
NEON_PORT=5432

# Or use a connection string
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require

# Redis Configuration (Optional - for caching and performance)
# If not provided, app will run without caching
REDIS_URL=redis://localhost:6379
# For Redis Cloud or managed Redis:
# REDIS_URL=redis://username:password@host:port

# Transactional Email (SMTP preferred; Resend remains supported as a fallback)
SMTP_HOST=mail.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
# Optional when the SMTP server certificate uses a different verified DNS name.
SMTP_TLS_SERVERNAME=
SMTP_USERNAME=noteclawverify@example.com
SMTP_PASSWORD=your-mailbox-password
SMTP_FROM_EMAIL=noteclawverify@example.com
SMTP_FROM_NAME=NoteClaw
SMTP_REPLY_TO_EMAIL=noteclawverify@example.com
PUBLIC_APP_URL=https://app.example.com
REQUIRE_EMAIL_VERIFICATION=true

# Google Play testing invitations
PLAY_TEST_OPT_IN_URL=https://play.google.com/apps/testing/com.note.claw
# Optional for a closed track authorized through a Google Group.
PLAY_TEST_GROUP_URL=
PLAY_TEST_FEEDBACK_EMAIL=noteclawverify@example.com

# Optional Resend fallback
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=NoteClaw
RESEND_REPLY_TO_EMAIL=

# AI Services
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key

# Search Services
SERPER_API_KEY=your-serper-api-key

# Audio Services (Optional)
ELEVENLABS_API_KEY=your-elevenlabs-api-key
DEEPGRAM_API_KEY=your-deepgram-api-key
ASSEMBLYAI_API_KEY=your-assemblyai-api-key
MURF_API_KEY=your-murf-api-key

# Payment Services (Optional)
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_SECRET=your-paypal-secret
PAYPAL_SANDBOX_MODE=true

STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_TEST_MODE=true

# Bunny.net CDN (Optional - for media storage)
BUNNY_STORAGE_ZONE=your-storage-zone-name
BUNNY_STORAGE_API_KEY=your-storage-api-key
BUNNY_CDN_HOSTNAME=your-zone.b-cdn.net
BUNNY_STORAGE_HOSTNAME=storage.bunnycdn.com

# Sports Data API (Optional - for live scores)
SPORTRADAR_API_KEY=your-sportradar-api-key

# Telegram Configuration (Optional - for Telegram bot)
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
